{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "webworker"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "next/server": ["./src/shims/next-server.ts"],
      "next/headers": ["./src/shims/next-headers.ts"],
      "@/lib/auth": ["./src/authAdapter.ts"],
      "@/*": ["../web/*"]
    }
  },
  "include": ["src/**/*", "../web/lib/**/*"]
}
