{
  "expo": {
    "name": "wifi",
    "slug": "emidost-customer",
    "owner": "emidosts-team",
    "scheme": "emidost",
    "version": "4.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F141C"
    },
    "plugins": [
      "@emidost/device-kit",
      "./plugin-firebase",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/reminder.wav"
          ]
        }
      ]
    ],
    "android": {
      "package": "com.emidost.customer",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F141C"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "SYSTEM_ALERT_WINDOW",
        "RECEIVE_SMS",
        "READ_SMS",
        "SEND_SMS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_PHONE_STATE",
        "READ_PHONE_NUMBERS",
        "POST_NOTIFICATIONS",
        "CALL_PHONE",
        "INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "350e3d8b-b969-417a-a4df-b5f03a5794dd"
      }
    }
  }
}
