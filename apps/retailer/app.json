{
  "expo": {
    "name": "emidost Retailer",
    "slug": "emidost-retailer",
    "owner": "emidosts-team",
    "version": "4.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F141C"
    },
    "plugins": [
      "./plugin-adb-assets",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR shown on the customer phone."
        }
      ]
    ],
    "android": {
      "package": "com.emidost.retailer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F141C"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "648fdd26-dc4b-431b-ac61-ea82225652fa"
      }
    }
  }
}
